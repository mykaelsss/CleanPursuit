# Copy to .env.local. Not a secret: Expo inlines EXPO_PUBLIC_ variables into the app bundle.
# Defaults to http://localhost:3000 (http://10.0.2.2:3000 on the Android emulator).
# On a physical device, use your computer's LAN address, such as http://192.168.1.20:3000.
EXPO_PUBLIC_API_URL=

# Google Maps API key for the events map, with the Maps SDK for Android (and iOS) enabled.
# Restrict it to the app's package name and signing certificate in Google Cloud.
# Read at build time, so rebuild the app (npm run android) after changing it.
GOOGLE_MAPS_API_KEY=
